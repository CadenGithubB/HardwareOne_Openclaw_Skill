# HardwareOne API Credentials (single device)
# Copy this to ~/.openclaw/hardwareone.env (host-only, OUTSIDE the skill dir) and fill it in.
# For MULTIPLE devices, use hardwareone.devices.json instead — see hardwareone.devices.json.template.
#
# HW1_URL is your device's current address. Prefer an explicit https:// URL so the
# transport is unambiguous and pinned. An explicit http:// URL is also pinned and
# is itself an opt-in to plaintext HTTP; use it only on a trusted, isolated LAN.
# A bare IP/host is treated as HTTPS. It can fall back to HTTP only when
# HW1_ALLOW_HTTP=1 is set and HTTPS refuses the connection. TLS/certificate errors,
# timeouts, redirects, and unexpected responses never cause an HTTP downgrade.
#
# Tip: give the device a static DHCP reservation. The firmware does not advertise
# an mDNS/.local name, so a hostname works only if your network provides DNS.

HW1_URL=
HW1_USER=
HW1_PASS=

# Examples:
# HW1_URL=https://192.0.2.42            # recommended: explicit HTTPS, pinned to HTTPS
# HW1_URL=hardwareone.example.test      # bare host: HTTPS only by default
# HW1_URL=http://198.51.100.50:8080     # explicit trusted-LAN HTTP opt-in; pinned to HTTP
# HW1_USER=admin
# HW1_PASS=your_password

# --- More than one device? ---
# Don't list them here. Create ~/.openclaw/hardwareone.devices.json — a clean structured
# registry with roles, shared defaults, and per-device TLS. See the template:
#   hardwareone.devices.json.template
# When that file exists the gateway uses it; otherwise it falls back to the single device above.

# --- Optional tuning (sensible defaults; uncomment to override) ---
# Timeouts, in seconds:
# HW1_CONNECT_TIMEOUT=5      # fail fast if the device is offline
# HW1_TIMEOUT=30             # per-request cap (covers ~12s password hashing)
# HW1_TIMEOUT_LONG=300       # slow commands (model ops, camera startup, certgen)
#
# HTTPS with a self-signed cert (device serves https://):
# HW1_CACERT=/path/to/device-ca.pem    # preferred: verify with this CA/certificate PEM
#                                      # (the device certificate's SAN must match HW1_URL)
# HW1_ALLOW_SELF_SIGNED=1              # alternative: disable certificate verification;
#                                      # trusted, isolated LAN only
#                                      # (legacy alias HW1_INSECURE=1 still works)
# Neither TLS option permits HTTP or changes an explicit URL's scheme.
#
# Plain HTTP for a bare IP/host (prefer an explicit http:// URL instead):
# HW1_ALLOW_HTTP=1                     # allow fallback only after HTTPS connection refusal;
#                                      # trusted, isolated LAN only
#
# Advanced:
# HW1_AUTH_PROBE=/api/system           # auth-gated path used to verify login succeeded
